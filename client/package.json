{
  "name": "@wwumit/dsh-phone",
  "version": "2.5.0",
  "description": "Agent phone client plugin — phone dialer overlay in DSH web UI, consuming CHA2A phone directory",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "agent-phone",
    "cha2a",
    "cordis"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=3.0.0",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0"
  },
  "dependencies": {
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "@types/qrcode-generator": "1.0.6",
    "@types/react": "^18.0.0",
    "tsdown": "latest",
    "typescript": "^5.6.0"
  },
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "lib/index.d.ts",
    "cordis.patch.yml",
    "CHANGELOG.md"
  ]
}